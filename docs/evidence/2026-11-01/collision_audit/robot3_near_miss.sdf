<sdf version="1.8"><world name="contact_fixture">
  <physics name="test" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>2</real_time_factor></physics>
  <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics" />
  <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster" />
  <plugin filename="libcollision_audit.so" name="rescue::CollisionAudit"><robot_model>robot3</robot_model><human_model>person_test</human_model></plugin>
  <plugin filename="libsocial_scenario_motion.so" name="rescue::SocialScenarioMotion">
    <motion><model>person_test</model><start>0</start><end>8</end><period>8</period>
      <key><time>0</time><pose>1 1 0 0 0 0</pose></key>
      <key><time>2</time><pose>0 1 0 0 0 0</pose></key>
      <key><time>4</time><pose>1 1 0 0 0 0</pose></key>
      <key><time>8</time><pose>1 1 0 0 0 0</pose></key>
    </motion>
  </plugin>
  <model name="ground_plane"><static>true</static><link name="floor"><collision name="floor_collision"><geometry><box><size>20 20 .2</size></box></geometry><pose>0 0 -.1 0 0 0</pose></collision></link></model>
  <model name="robot3"><pose>0 0 .12 0 0 0</pose><link name="body">
    <inertial><mass>1</mass><inertia><ixx>.01</ixx><iyy>.01</iyy><izz>.01</izz></inertia></inertial>
    <collision name="body_collision"><geometry><cylinder><radius>.15</radius><length>.2</length></cylinder></geometry></collision>
  </link></model>
  <model name="person_test"><static>true</static><pose>1 1 0 0 0 0</pose><link name="body">
    <collision name="body_envelope"><pose>0 0 .89 0 0 0</pose><geometry><cylinder><radius>.32</radius><length>1.78</length></cylinder></geometry></collision>
  </link></model>
</world></sdf>